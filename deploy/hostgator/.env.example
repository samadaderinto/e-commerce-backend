# FORMAT EXAMPLES ONLY: credentials and personal details below are fictional.
# Replace every fake/REPLACE value before enabling an integration or deploying.
# For offline development, clear unused provider keys and social IDs; keep FCM disabled
# and EMAIL_BACKEND on console. Nonempty fake values may make features appear configured.

PUBLIC_DOMAIN=proaceintlshoppingmall.com
COMMERCE_NETWORK=commerce-network
DJANGO_DEBUG=false
# Example pool only; size explicitly from production queue/throughput requirements.
CELERY_WORKER_CONCURRENCY=2
SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_HOSTS=proaceintlshoppingmall.com,www.proaceintlshoppingmall.com,api
FRONTEND_URL=https://proaceintlshoppingmall.com
CSRF_TRUSTED_ORIGINS=https://proaceintlshoppingmall.com,https://www.proaceintlshoppingmall.com
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
API_URL=http://api:8000/api/v1
CONTAINER_NOTIFICATION_STREAM_URL=http://notification-stream:8000/api/v1
STREAM_WORKERS=1
STREAM_THREADS=32
ELASTICSEARCH_CONNECTIONS_PER_NODE=32

DEFAULT_ADMIN_EMAIL=admin@proaceintl.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
TECHNICAL_ADMIN_EMAIL=${DEFAULT_ADMIN_EMAIL}
TECHNICAL_ADMIN_PASSWORD=${DEFAULT_ADMIN_PASSWORD}
DEFAULT_ADMIN_FIRST_NAME=ProAce
DEFAULT_ADMIN_LAST_NAME=Administrator
DEFAULT_ADMIN_GENDER=male
DEFAULT_ADMIN_PHONE=+12025550101

POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_EXPORTER_USER=${POSTGRES_USER}
POSTGRES_EXPORTER_PASSWORD=${POSTGRES_PASSWORD}
OBSERVABILITY_TOKEN=replace-with-a-private-random-token

# Payments & Store Credit
STRIPE_SECRET=sk_live_FAKE_EXAMPLE_REPLACE_WITH_REAL_KEY
PUBLISHER_KEY=pk_live_FAKE_EXAMPLE_REPLACE_WITH_REAL_KEY
STRIPE_WALLET_PAYMENT_METHODS=cashapp
STRIPE_CURRENCY=usd

OBJECT_STORAGE_ENABLED=false
INSTALL_OBJECT_STORAGE=false
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_SERVICE_NAME=commerce-api
OTEL_TRACES_SAMPLER_ARG=0.05

EMAIL_BACKEND=notification.email_backend.ResendEmailBackend
RESEND_API_KEY=re_FAKE_EXAMPLE_REPLACE_WITH_REAL_KEY
RESEND_FROM_EMAIL=ProAce <admin@proaceintl.com>
FCM_ENABLED=false
FIREBASE_PROJECT_ID=proace-example
FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"proace-example","private_key_id":"FAKE_PRIVATE_KEY_ID_REPLACE_ME","private_key":"-----BEGIN PRIVATE KEY-----\nFAKE_KEY_CONTENT_REPLACE_WITH_DOWNLOADED_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-example@proace-example.iam.gserviceaccount.com","client_id":"123456789012345678901","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-example%40proace-example.iam.gserviceaccount.com","universe_domain":"googleapis.com"}'
GOOGLE_CLIENT_ID=123456789012-fakeexampleclientid.apps.googleusercontent.com
