# FORMAT EXAMPLES ONLY: credentials and personal details below are fictional.
# Replace every fake/REPLACE value before enabling an integration or deploying.
# For offline development, clear unused provider keys and social IDs; keep FCM disabled
# and EMAIL_BACKEND on console. Nonempty fake values may make features appear configured.

API_URL=http://127.0.0.1:8000/api/v1
# Optional dedicated SSE origin; blank keeps the single-process local-dev path.
NOTIFICATION_STREAM_URL=
E2E_BASE_URL=http://127.0.0.1:3000
E2E_DEMO_PASSWORD=ProaceDemo2026!

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_FAKE_EXAMPLE_REPLACE_WITH_REAL_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=proace-example.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=proace-example
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=proace-example.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BFAKE_EXAMPLE_REPLACE_WITH_FULL_PUBLIC_WEB_PUSH_KEY

# Rebuild the client container after changing these values.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789012-fakeexampleclientid.apps.googleusercontent.com
NEXT_PUBLIC_APPLE_CLIENT_ID=com.example.proace.web

# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Host development keeps this false. Compose sets true for private Next.js behind Nginx.
TRUSTED_EDGE_PROXY=false
