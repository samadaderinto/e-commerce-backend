DJANGO_SETTINGS_MODULE=codematics.storefront_settings
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://127.0.0.1:3000
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# Set FIREBASE_CREDENTIALS_JSON when testing FCM locally; never commit credentials.
FIREBASE_CREDENTIALS_JSON=
STRIPE_WALLET_PAYMENT_METHODS=cashapp
STRIPE_CURRENCY=ngn
SECRET_KEY=replace-with-a-long-random-value
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
# Used by Django when running directly on the host. Compose sets CACHE_URL to redis://redis:6379/0.
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/0
OBSERVABILITY_TOKEN=replace-with-a-private-metrics-token
LOG_LEVEL=INFO
OBJECT_STORAGE_ENABLED=false
INSTALL_OBJECT_STORAGE=false
DATABASE_ENGINE=postgres
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT_HOST=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_REQUIRE_SSL=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_LOGGING_ENABLED=false
KAFKA_LOG_TOPIC=commerce.logs
KAFKA_LOG_GROUP=commerce-log-indexer
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
RABBITMQ_DEFAULT_USER=commerce
RABBITMQ_DEFAULT_PASS=change-me-local
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=8
NOTIFICATION_DELIVERY_STALE_SECONDS=300
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Proace <hello@proace.example>
APPLICATION_EMAIL=Proace <hello@proace.example>
CELERY_BROKER_URL=amqp://commerce:change-me-local@127.0.0.1:5672//
CELERY_RESULT_BACKEND=rpc://
LOCAL_PROFILING_ENABLED=false
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=commerce-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER_ARG=0.1
# Monitoring containers default to Docker service names and these app credentials.
# Override only for an external or TLS-enabled service.
POSTGRES_EXPORTER_URI=postgres:5432/postgres?sslmode=disable
POSTGRES_EXPORTER_USER=commerce
POSTGRES_EXPORTER_PASSWORD=replace-with-a-database-password
REDIS_EXPORTER_ADDR=redis://redis:6379
REDIS_EXPORTER_PASSWORD=
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_PRODUCTS_INDEX=commerce-products
ELASTICSEARCH_BIND_ADDRESS=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
ELASTICSEARCH_EXPORTER_URI=http://elasticsearch:9200

# MinIO Docker Compose (local development credentials; replace for deployment).
MINIO_ROOT_USER=commerce-admin
MINIO_ROOT_PASSWORD=local-minio-admin-change-me
MINIO_ACCESS_KEY=commerce-media
MINIO_SECRET_KEY=local-minio-media-change-me
MINIO_BUCKET_NAME=commerce-images
MINIO_REGION=us-east-1
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Use http://minio:9000 when Django runs in the same Docker network.
MINIO_ENDPOINT_URL=http://127.0.0.1:9000
# Browser-reachable address, without a bucket suffix.
MINIO_PUBLIC_URL=http://127.0.0.1:9000
# Set a strong SECRET_KEY and configure SMTP before deployment.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Proace <hello@example.com>
# APPLICATION_EMAIL=Proace <hello@example.com>
