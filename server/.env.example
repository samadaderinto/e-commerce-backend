# FORMAT EXAMPLES ONLY: credentials and personal details below are fictional.
# Replace every fake/REPLACE value before enabling an integration or deploying.
# For offline development, clear unused provider keys and social IDs; keep FCM disabled
# and EMAIL_BACKEND on console. Nonempty fake values may make features appear configured.

# ==============================================================================
# PROACE COMMERCE — SERVER ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO & RUNTIME
# Core application settings, security keys, debug flags, and network origins.
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=codematics.storefront_settings
DJANGO_DEBUG=true
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080
LOG_LEVEL=INFO
LOCAL_PROFILING_ENABLED=false
GUNICORN_THREADS=32
# Dedicated internal notification stream process (not ordinary API workers).
STREAM_WORKERS=1
STREAM_THREADS=32

# ------------------------------------------------------------------------------
# 2. DEFAULT ACCOUNTS & IDENTITY
# Initial superuser, technical admin sync, business admin, and staff user configs.
# ------------------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_ADMIN_PASSWORD
TECHNICAL_ADMIN_EMAIL=${DEFAULT_ADMIN_EMAIL}
TECHNICAL_ADMIN_PASSWORD=${DEFAULT_ADMIN_PASSWORD}
GRAFANA_ADMIN_PASSWORD=${DEFAULT_ADMIN_PASSWORD}
DEFAULT_ADMIN_FIRST_NAME=Example
DEFAULT_ADMIN_LAST_NAME=Administrator
DEFAULT_ADMIN_GENDER=male
DEFAULT_ADMIN_PHONE=+12025550101

BUSINESS_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_BUSINESS_ADMIN_PASSWORD

DEFAULT_STAFF_EMAIL=staff@example.com
DEFAULT_STAFF_PASSWORD=REPLACE_WITH_UNIQUE_STAFF_PASSWORD
DEFAULT_STAFF_FIRST_NAME=Example
DEFAULT_STAFF_LAST_NAME=Staff
DEFAULT_STAFF_GENDER=female
DEFAULT_STAFF_PHONE=+12025550102

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL)
# PostgreSQL connection credentials and database engine parameters.
# ------------------------------------------------------------------------------
DATABASE_ENGINE=postgres
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
DB_REQUIRE_SSL=false

# ------------------------------------------------------------------------------
# 4. CACHE & REALTIME (REDIS)
# Redis-backed Django cache and real-time server connections.
# CACHE_URL is required for runtime caching; tests override this with LocMemCache.
# ------------------------------------------------------------------------------
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_URL=${REDIS_URL}
REALTIME_REDIS_URL=${REDIS_URL}

# ------------------------------------------------------------------------------
# 5. SEARCH ENGINE (ELASTICSEARCH)
# Search engine cluster URL, memory allocation, and catalog index settings.
# ------------------------------------------------------------------------------
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_CONNECTIONS_PER_NODE=32
# Anonymous ID-only searches may use Elasticsearch's refresh-invalidated cache.
SEARCH_REQUEST_CACHE_ENABLED=true
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_PRODUCTS_INDEX=commerce-products
ELASTICSEARCH_BIND_ADDRESS=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (MINIO / S3)
# S3-compatible media uploads, bucket configurations, and credentials.
# ------------------------------------------------------------------------------
OBJECT_STORAGE_ENABLED=true
INSTALL_OBJECT_STORAGE=true
MINIO_ROOT_USER=${DEFAULT_ADMIN_EMAIL}
MINIO_ROOT_PASSWORD=${DEFAULT_ADMIN_PASSWORD}
MINIO_ACCESS_KEY=commerce-media
MINIO_SECRET_KEY=local-minio-media-change-me
MINIO_BUCKET_NAME=commerce-images
MINIO_REGION=us-east-1
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT_URL=http://127.0.0.1:9000
CONTAINER_MINIO_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_SIGNED_URL_TTL=900

# ------------------------------------------------------------------------------
# 7. ASYNC TASKS, QUEUES & NOTIFICATIONS
# Celery worker, RabbitMQ/Redis broker, email delivery, and Firebase push.
# ------------------------------------------------------------------------------
QUEUE_EMAILS=true
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false
# Local Compose pool; host-managed Celery retains its own concurrency settings.
CELERY_WORKER_CONCURRENCY=2
RABBITMQ_DEFAULT_USER=commerce
RABBITMQ_DEFAULT_PASS=change-me-local
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=8
NOTIFICATION_DELIVERY_STALE_SECONDS=300

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=re_FAKE_EXAMPLE_REPLACE_WITH_REAL_KEY
SUPPORT_EMAIL=admin@proaceintl.com
ORDER_SUPPORT_EMAIL=productace@proaceintl.com
RESEND_FROM_EMAIL=ProAce <${SUPPORT_EMAIL}>

FCM_ENABLED=false
FIREBASE_PROJECT_ID=proace-example
# Download the complete service-account JSON; preserve literal \n in private_key.
# This fake key demonstrates formatting only and cannot initialize Firebase Admin.
FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"proace-example","private_key_id":"FAKE_PRIVATE_KEY_ID_REPLACE_ME","private_key":"-----BEGIN PRIVATE KEY-----\nFAKE_KEY_CONTENT_REPLACE_WITH_DOWNLOADED_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-example@proace-example.iam.gserviceaccount.com","client_id":"123456789012345678901","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-example%40proace-example.iam.gserviceaccount.com","universe_domain":"googleapis.com"}'

# ------------------------------------------------------------------------------
# 8. PAYMENTS & COMMERCE CHECKOUT
# Stripe checkout tokens, supported digital wallets, currency, and tax rate.
# ------------------------------------------------------------------------------
STRIPE_SECRET=sk_test_FAKE_EXAMPLE_REPLACE_WITH_REAL_KEY
PUBLISHER_KEY=pk_test_FAKE_EXAMPLE_REPLACE_WITH_REAL_KEY
STRIPE_WALLET_PAYMENT_METHODS=card,cashapp
STRIPE_WEBHOOK_SECRET=whsec_your_actual_secret
STRIPE_CURRENCY=usd
CHECKOUT_TAX_RATE=0
TAX_PROVIDER=local
STRIPE_TAX_ENABLED=false

# ------------------------------------------------------------------------------
# 9. SHIPPING & CARRIER INTEGRATIONS
# Multi-carrier quote credentials (USPS, FedEx, DHL, UPS) and default package dimensions.
# ------------------------------------------------------------------------------
SHIPPING_RATE_MODE=demo
SHIPPING_SANDBOX=true
USPS_CLIENT_ID=FAKE_EXAMPLE_REPLACE_WITH_REAL_USPS_CLIENT_ID
USPS_CLIENT_SECRET=FAKE_EXAMPLE_REPLACE_WITH_REAL_USPS_CLIENT_SECRET
UPS_CLIENT_ID=FAKE_EXAMPLE_REPLACE_WITH_REAL_UPS_CLIENT_ID
UPS_CLIENT_SECRET=FAKE_EXAMPLE_REPLACE_WITH_REAL_UPS_CLIENT_SECRET
UPS_ACCOUNT_NUMBER=EX1234
FEDEX_CLIENT_ID=FAKE_EXAMPLE_REPLACE_WITH_REAL_FEDEX_CLIENT_ID
FEDEX_CLIENT_SECRET=FAKE_EXAMPLE_REPLACE_WITH_REAL_FEDEX_CLIENT_SECRET
FEDEX_ACCOUNT_NUMBER=123456789
DHL_API_KEY=FAKE_EXAMPLE_REPLACE_WITH_REAL_DHL_API_KEY
DHL_API_SECRET=FAKE_EXAMPLE_REPLACE_WITH_REAL_DHL_API_SECRET
DHL_ACCOUNT_NUMBER=123456789
SHIPPING_PACKAGE_LENGTH_IN=10
SHIPPING_PACKAGE_WIDTH_IN=8
SHIPPING_PACKAGE_HEIGHT_IN=4

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & MONITORING EXPORTERS
# Metrics tokens, OpenTelemetry tracing, Kafka logs, and Prometheus exporter targets.
# ------------------------------------------------------------------------------
OBSERVABILITY_TOKEN=replace-with-a-private-metrics-token

OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=commerce-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER_ARG=0.1

POSTGRES_EXPORTER_URI=postgres:5432/postgres?sslmode=disable
POSTGRES_EXPORTER_USER=${POSTGRES_USER}
POSTGRES_EXPORTER_PASSWORD=${POSTGRES_PASSWORD}

REDIS_EXPORTER_ADDR=redis://redis:6379
REDIS_EXPORTER_PASSWORD=REPLACE_WITH_REDIS_PASSWORD_IF_AUTH_ENABLED

ELASTICSEARCH_EXPORTER_URI=http://elasticsearch:9200

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_LOGGING_ENABLED=false
KAFKA_LOG_TOPIC=commerce.logs
KAFKA_LOG_GROUP=commerce-log-indexer
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ------------------------------------------------------------------------------
# 11. AFFILIATES & PARTNER NETWORKS (CLICKBANK)
# ProAce affiliate tracking nickname, INS webhook secret, and developer API keys.
# ------------------------------------------------------------------------------
CLICKBANK_AFFILIATE_NICKNAME=proace
CLICKBANK_SECRET_KEY=FAKE_EXAMPLE_REPLACE_WITH_REAL_CLICKBANK_SECRET_KEY
CLICKBANK_DEV_KEY=FAKE_EXAMPLE_REPLACE_WITH_REAL_CLICKBANK_DEV_KEY

# ------------------------------------------------------------------------------
# 12. SOCIAL AUTHENTICATION (GOOGLE & APPLE)
# Client IDs for verifying Google and Apple customer identity tokens.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=123456789012-fakeexampleclientid.apps.googleusercontent.com
APPLE_CLIENT_ID=com.example.proace.web


# Short-lived anonymous catalog snapshots; 0 disables (maximum 60 seconds).
PUBLIC_CATALOG_CACHE_SECONDS=15

# Two API processes; live notification streams also occupy request threads.
GUNICORN_THREADS=32
