local.file_match "commerce" {
  path_targets = [{"__path__" = "/var/log/commerce/*.jsonl", "service_name" = "commerce-api"}]
}
loki.source.file "commerce" {
  targets    = local.file_match.commerce.targets
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
